# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=sayarti
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# JWT authentication (generate separate strong secrets; never commit real values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# Google ID-token audience
GOOGLE_CLIENT_ID=

# Firebase Admin service-account JSON file (optional; notifications use a safe fallback when blank)
FIREBASE_SERVICE_ACCOUNT_PATH=

# LOCAL email verification OTP policy
EMAIL_OTP_EXPIRATION_SECONDS=300
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# SMTP email delivery
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL=false
SMTP_CONNECTION_TIMEOUT=10000
SMTP_TIMEOUT=60000
SMTP_WRITE_TIMEOUT=60000

# Browser clients allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# In-process V1 reminder scheduler
REMINDER_SCHEDULER_INTERVAL_MS=60000
REMINDER_SCHEDULER_BATCH_SIZE=100
